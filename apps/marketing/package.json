{
  "name": "mpa-marketing",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site for Make PDF Accessible (makepdfaccessible.com): static Next.js export deployed to S3 and CloudFront",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "serve out -l 3100 --no-clipboard",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "check:copy": "node scripts/check-banned-phrases.mjs",
    "test": "pnpm run check:copy",
    "test:a11y": "playwright test",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^9.1.2",
    "postcss": "^8.5.3",
    "prettier": "^3.0.3",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
