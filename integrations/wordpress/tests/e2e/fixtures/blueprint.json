{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "MAKE_PDF_ACCESSIBLE_E2E": true,
        "WP_HTTP_BLOCK_EXTERNAL": true,
        "DISABLE_WP_CRON": true,
        "AUTOMATIC_UPDATER_DISABLED": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": { "permalink_structure": "/%postname%/" }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/make-pdf-accessible/make-pdf-accessible.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/make-pdf-accessible/tests/e2e/fixtures/seed.php';"
    }
  ]
}
