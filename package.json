{
  "name": "make-pdf-accessible-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for PDF accessibility tools and services",
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:web": "pnpm --filter=web dev",
    "dev:dashboard": "pnpm --filter=accesspdf-dashboard dev",
    "dev:frontend": "concurrently \"pnpm dev:web\" \"pnpm dev:dashboard\"",
    "dev:full": "pnpm dev && pnpm dev:frontend",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "clean": "pnpm -r clean && docker-compose down -v",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.2",
    "asl-validator": "^4.0.0",
    "concurrently": "^10.0.5",
    "danger": "^14.0.7",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "whatwg-node": "0.0.1-security"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "node-fetch": "^3.3.2"
  },
  "pnpm": {
    "overrides": {
      "playwright": ">=1.55.1",
      "tar-fs@>=2.1.0 <2.1.4": ">=2.1.4",
      "tar-fs@>=3.0.0 <3.1.1": ">=3.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "jws": ">=3.2.3",
      "fast-xml-parser@>=5.0.9 <=5.3.3": ">=5.3.4",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "@smithy/config-resolver": ">=4.4.0",
      "qs@<6.14.2": ">=6.14.2",
      "undici@>=6.0.0 <6.24.0": "^6.24.0",
      "minimatch@>=9.0.0 <9.0.6": "^9.0.6",
      "postcss@<8.5.12": "^8.5.12",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
