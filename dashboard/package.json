{
  "name": "accesspdf-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next build --no-lint",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:auth": "node scripts/test-auth-basic.js",
    "test:ui": "playwright test --ui",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage --coverageThreshold='{}' --passWithNoTests",
    "test:watch": "jest --watch --testPathPatterns=tests/unit",
    "seed:admin": "tsx ../packages/scripts/seed-admin-mongo.ts",
    "db:auth:migrate": "better-auth migrate --config src/lib/auth-server.ts --yes"
  },
